{
  "$schema": "https://turborepo.com/schema.json",
  "globalDependencies": [
    "**/.env.*local",
    "Cargo.toml",
    "Cargo.lock",
    "clippy.toml",
    "rust-toolchain.toml",
    ".oxlintrc.json",
    "tsconfig.json",
    "packages/lints/bindings.json",
    "packages/oxlint-config/config.json",
    "*.json",
    "*.toml",
    "*.yaml",
    "*.mjs",
    ".nvmrc",
    ".github/**",
    "bin/test-shard",
    ".oxfmtrc.json",
    ".gitignore",
    ".editorconfig"
  ],
  "globalPassThroughEnv": ["CARGO_HOME", "RUSTUP_HOME", "RUSTUP_TOOLCHAIN", "DOC_LINKS_LOG"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["transit"],
      "outputs": []
    },
    "lint:fix": {
      "cache": false,
      "dependsOn": ["transit"]
    },
    "test": {
      "dependsOn": ["transit"],
      "outputs": []
    },
    "transit": {
      "dependsOn": ["^transit"]
    },
    "typecheck": {
      "dependsOn": ["transit"],
      "outputs": []
    },
    "@yaai/lint#lint": {
      "cache": false,
      "outputs": []
    }
  },
  "ui": "stream"
}
