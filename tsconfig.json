{
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "erasableSyntaxOnly": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "target": "ESNext",
    "module": "Preserve",
    "types": ["bun"],
    "skipLibCheck": true
  },
  "include": [".agents/hooks", ".omp/extensions", ".pi/extensions", "packages", "apps", "tooling", ".github/ci"]
}
